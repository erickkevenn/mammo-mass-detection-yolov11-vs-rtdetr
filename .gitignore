ds/

# RSNA Breast Cancer Detection (zip de ~290 GB + pasta descompactada)
rsna-breast-cancer-detection/
rsna-breast-cancer-detection.zip

*.zip
*.tar
*.tar.gz
*.7z
*.rar

# DICOM e imagens médicas soltas
*.dcm
*.dicom
*.pgm
*.nii
*.nii.gz

# ─────────────────────────────────────────────────────────────
# Dados gerados pelo pipeline
# ─────────────────────────────────────────────────────────────
data/
!data/.gitkeep

# Exceções: metadados pequenos e úteis para reprodutibilidade.
# Descomente se quiser versioná-los (nenhum contém pixels de imagem).
# !data/hub/
# !data/hub/annotations.csv
# !data/hub/splits.json
# !data/hub/checksums.json

